// Amplifier Quickstart Dev Container
// このコンテナを開くだけで、Amplifier (amplifier-claude ブランチ) のクイックスタート
// 前提条件のインストールと `make install` までが自動で完了します。
// 学生はビルド完了後、ターミナルで `claude` と打つだけで使い始められます。
//
// 形式の詳細: https://aka.ms/devcontainer.json
// Claude Code 公式: https://code.claude.com/docs/ja/devcontainer
{
  "name": "amplifier-quickstart",

  // Python 3.11+ を含む公式 devcontainer ベースイメージ（非 root の vscode ユーザー入り）
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",

  // クイックスタート前提条件を宣言的にインストール（カスタムスクリプト不要）
  "features": {
    // make: Amplifier の `make install` / `make check` 等に必要
    "ghcr.io/jungaretti/features/make:1": {},

    // uv: Python パッケージマネージャ（pipx 経由で導入）
    "ghcr.io/devcontainers-extra/features/pipx-package:1": {
      "package": "uv",
      "version": "latest"
    },

    // Node.js + pnpm: Amplifier の Node 系依存に必要
    "ghcr.io/devcontainers/features/node:1": {
      "nodeGypDependencies": true,
      "version": "lts",
      "pnpmVersion": "latest"
    },

    // Claude Code 本体（CLI と VS Code 拡張を導入）
    // 末尾の :1.0 は機能インストーラのピン留め。CLI は最新版が入り、既定で自動更新されます。
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},

    // gh CLI（任意。後で自分のプロジェクトを GitHub に作る際に便利）
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // コンテナ作成後にクローン + 依存インストールを実行（claude を打つ直前まで）
  "postCreateCommand": "bash .devcontainer/post-create.sh",

  // 再ビルドしても Claude のログイン状態・設定・履歴 (~/.claude) を保持する名前付きボリューム。
  // ${devcontainerId} を含めることで、このコンテナ専用のボリュームに分離されます。
  "mounts": [
    "source=amplifier-claude-config-${devcontainerId},target=/home/vscode/.claude,type=volume"
  ],

  // uv キャッシュをワークスペースと同じディスク上に置き、依存解決を高速化
  "containerEnv": {
    "UV_CACHE_DIR": "${containerWorkspaceFolder}/.cache/uv"
  },

  // 非 root ユーザーで実行（Claude Code の推奨）
  "remoteUser": "vscode",

  // ローカル Docker / Codespaces 双方向けの目安リソース
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "charliermarsh.ruff",
        "ms-python.python",
        "ms-vscode.makefile-tools",
        "tamasfe.even-better-toml",
        "bierner.markdown-mermaid"
      ]
    }
  }
}
